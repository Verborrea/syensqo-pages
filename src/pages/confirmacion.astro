---
import { Image } from "astro:assets";
import { CalendarDays, Clock, University, CircleCheck } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import logo from "../assets/logo.png";

const base = import.meta.env.BASE_URL;

const EVENT = {
  date: "23 de Octubre del 2026",
  time: "08:20 am - 19:40 pm",
  location: "Hotel Costa del Sol, Arequipa",
};
---

<Layout
  title="Inscripción confirmada | Syensqo"
  description="Tu inscripción al 4to Seminario Técnico de Syensqo fue confirmada."
>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-x-hidden bg-linear-0 from-orange-100 to-white p-6"
  >
    <div class="absolute top-9 left-0 w-full px-6">
      <div class="mx-auto max-w-287">
        <Image
          src={logo}
          alt="Syensqo"
          width={167}
          densities={[1, 2]}
          format="png"
        />
      </div>
    </div>

    <div
      class="flex w-full max-w-lg flex-col items-center gap-6 rounded-3xl border border-slate-200 bg-white p-8 text-center text-text shadow-xl"
    >
      <CircleCheck class="size-14 text-main" stroke-width={1.75} />
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">¡Ya estás inscrito!</h1>
        <p class="text-sm text-slate-500">
          Tu inscripción al 4to Seminario Técnico Syensqo quedó registrada.
        </p>
      </div>

      <ul class="flex flex-col gap-3 self-start">
        <li class="item">
          <CalendarDays />
          <p>{EVENT.date}</p>
        </li>
        <li class="item">
          <Clock />
          <p>{EVENT.time}</p>
        </li>
        <li class="item">
          <University />
          <p>{EVENT.location}</p>
        </li>
      </ul>

      <a href={base} class="button w-full">Volver al inicio</a>
    </div>
  </main>
</Layout>
